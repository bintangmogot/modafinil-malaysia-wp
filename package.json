{
  "name": "modafinil-malaysia-wp",
  "version": "1.0.0",
  "description": "Modafinil Malaysia WordPress Theme",
  "private": true,
  "scripts": {
    "build": "npx @tailwindcss/cli -i ./assets/css/source.css -o ./assets/css/main.css --minify",
    "tailwind": "npx @tailwindcss/cli -i ./assets/css/source.css -o ./assets/css/main.css --watch",
    "sync": "browser-sync start --proxy \"http://modafinil-malaysia.test\" --files \"*.php, modules/**/*.php, template-parts/**/*.php, woocommerce/**/*.php, assets/css/main.css, assets/js/*.js\" --ignore \"node_modules/**/*\"",
    "dev": "npm-run-all --parallel tailwind sync"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "browser-sync": "^3.0.4",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^4.0.0"
  },
  "dependencies": {
    "sharp": "^0.35.3",
    "tw-animate-css": "^1.4.0"
  }
}
